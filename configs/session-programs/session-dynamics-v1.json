  "scenarios": [
    {
      "id": "independent",
      "description": "Four independent prompts per group; no shared prefix across groups. Baseline at matched input lengths."
    },
    {
      "id": "stable_prefix",
      "description": "Four independent turns sharing a stable synthetic prefix within a group; change only matched-size suffixes. First turn is measured, not hidden warmup."
    },
    {
      "id": "prefix_invalidation",
      "description": "Matched stable-prefix sequence with an early prefix change on turns 3-4. Keep lengths and suffix tasks matched to stable_prefix."
    },
    {
      "id": "growing_transcript",
      "description": "Four dependent turns retaining real assistant replies, explicit transcript append and bounded input growth; no implicit compaction."
    },
    {
      "id": "interleaved_sessions",
      "description": "Same four-turn dependent sessions, round-robin scheduling across five sessions; retain per-session order and no cross-session history."
    },
    {
      "id": "client_reconnect",
      "description": "Matched growing session with a new client connection between turns 2 and 3, same logical transcript. This does not assert a server cache reset."
    },
    {
      "id": "explicit_compaction",
      "description": "Matched growing transcript, with deterministic local compaction before turn 3. Preserve designated sentinel facts; record original and compacted token sizes. No model call for compaction."
    },
    {
      "id": "idle_resume",
      "description": "Matched session with a 60-second pause before turn 3. Report idle gap separately from active and end-to-end elapsed time; deterministic finite scheduling."
    },
    {
      "id": "tool_roundtrip",
      "description": "Four model calls per session with deterministic in-process tools and real tool-result continuation. Count every model call; do not execute model-supplied shell/network actions. Unsupported tools are recorded as unsupported, never substituted silently."
    }
  ],
