  "scenarios": [
    {
      "id": "independent",
      "description": "Four independent prompts per group; no shared prefix across groups. Baseline at matched input length."
    },
    {
      "id": "stable_prefix",
      "description": "The same fixed prefix is reused across four turns; paired with the independent baseline at matched input length."
    },
    {
      "id": "prefix_invalidation",
      "description": "A new leading cache namespace at turn 3; turns 1-2 keep the original prefix."
    },
    {
      "id": "growing_transcript",
      "description": "Each turn appends the retained assistant reply; the history grows without compaction."
    },
    {
      "id": "interleaved_sessions",
      "description": "Five sessions take turns in a frozen order; each session's transcript still grows."
    },
    {
      "id": "client_reconnect",
      "description": "The client closes and re-establishes the transport at turn 3; the transcript is preserved."
    },
    {
      "id": "explicit_compaction",
      "description": "A fixed summary replaces older history at turn 3; the namespace marker stays stable."
    },
    {
      "id": "idle_resume",
      "description": "A bounded idle pause precedes the resume turn; no hidden warmup call is made."
    },
    {
      "id": "tool_roundtrip",
      "description": "A deterministic tool call and continuation are attempted inside the live turn loop."
    },
    {
      "id": "context_sentinels",
      "description": "One request per sentinel position at 32768, 65536 and 131072 requested input tokens."
    }
  ],
